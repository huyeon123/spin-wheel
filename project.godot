config_version=5

[application]
config/name="돌려봐 · Spin Wheel"
config/version="0.2.7"
boot_splash/image="res://assets/splash.png"
boot_splash/bg_color=Color(0.945, 0.957, 0.984, 1)
boot_splash/show_image=true
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=480
window/size/viewport_height=800
window/size/window_width_override=360
window/size/window_height_override=600
window/size/min_width=240
window/size/min_height=320
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.945, 0.957, 0.984, 1)


[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
